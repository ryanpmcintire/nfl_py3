#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ "${NFL_ATS_SKIP_HANDOFF:-0}" = "1" ]; then
    exit 0
fi

if [ -x "./.venv/Scripts/python.exe" ]; then
    ./.venv/Scripts/python.exe -m nfl_ats handoff >/dev/null
elif [ -x "./.venv/bin/python" ]; then
    ./.venv/bin/python -m nfl_ats handoff >/dev/null
elif [ -x "./.tools/uv.exe" ]; then
    ./.tools/uv.exe run nfl-ats handoff >/dev/null
elif command -v uv >/dev/null 2>&1; then
    uv run nfl-ats handoff >/dev/null
else
    echo "error: cannot refresh HANDOFF.md because the project environment is unavailable" >&2
    exit 1
fi

# `nfl-ats handoff` also refreshes README.md's generated ACTIVE_MODEL_STATE
# and RESEARCH_STATE blocks (nfl_ats.readme_state) when README.md exists, the
# same way it has always refreshed HANDOFF.md -- stage both.
git add -- HANDOFF.md
if [ -f README.md ]; then
    git add -- README.md
fi
