#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

run_handoff_check() {
    if [ -x "./.venv/Scripts/python.exe" ]; then
        ./.venv/Scripts/python.exe -m nfl_ats handoff --check >/dev/null
    elif [ -x "./.venv/bin/python" ]; then
        ./.venv/bin/python -m nfl_ats handoff --check >/dev/null
    elif [ -x "./.tools/uv.exe" ]; then
        ./.tools/uv.exe run nfl-ats handoff --check >/dev/null
    elif command -v uv >/dev/null 2>&1; then
        uv run nfl-ats handoff --check >/dev/null
    else
        echo "error: cannot verify HANDOFF.md because the project environment is unavailable" >&2
        return 1
    fi
}

while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$remote_ref" != "refs/heads/master" ]; then
        continue
    fi
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    if ! run_handoff_check; then
        echo "error: master push blocked because the automatic session handoff is stale" >&2
        exit 1
    fi

    handoff_commit=$(git rev-list -1 "$local_oid" -- HANDOFF.md)
    if [ "$handoff_commit" != "$local_oid" ]; then
        echo "error: master push blocked; the tip commit must include automatic HANDOFF.md refresh" >&2
        exit 1
    fi

    if ! git diff --quiet -- HANDOFF.md || ! git diff --cached --quiet -- HANDOFF.md; then
        echo "error: master push blocked; HANDOFF.md has uncommitted changes" >&2
        exit 1
    fi
done
